<shape xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:androidprv="http://schemas.android.com/apk/prv/res/android"
    android:shape="rectangle">
    <!-- Same gradient as ROM banner for visual consistency -->
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="@androidprv:color/materialColorPrimaryContainer"
        android:endColor="@androidprv:color/materialColorSurfaceVariant" />
    <!-- Pill shape: 50% of typical card height (~40dp for 80dp card) -->
    <corners android:radius="40dp" />
</shape>

<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="my_device_info_pref_screen"
    android:title="@string/about_settings">

    <!-- Kamisato Hero Header -->
    <com.android.settingslib.widget.LayoutPreference
        android:key="kamisato_about_header"
        android:order="0"
        android:layout="@layout/kamisato_about_header"
        android:selectable="false"
        settings:allowDividerBelow="false" />

    <!-- Device Information Card -->
    <PreferenceCategory
        android:key="kamisato_device_info_category"
        android:order="10"
        android:title="@string/kamisato_about_device_info"
        android:icon="@drawable/ic_kamisato_device">

        <!-- Device name -->
        <com.android.settings.widget.ValidatedEditTextPreference
            android:key="device_name"
            android:order="11"
            android:title="@string/my_device_info_device_name_preference_title"
            android:summary="@string/summary_placeholder"
            settings:controller="com.android.settings.deviceinfo.DeviceNamePreferenceController"
            settings:enableCopying="true"/>

        <!-- Device Codename (ro.kamisato.device) -->
        <Preference
            android:key="kamisato_device_codename"
            android:order="12"
            android:title="@string/kamisato_device_codename"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.kamisato.KamisatoDeviceCodenamePreferenceController"
            settings:enableCopying="true"/>

        <!-- Maintainer (ro.kamisato.maintainer) -->
        <Preference
            android:key="kamisato_maintainer"
            android:order="13"
            android:title="@string/kamisato_maintainer"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.kamisato.KamisatoMaintainerPreferenceController"
            settings:enableCopying="true"/>

    </PreferenceCategory>

    <!-- Hardware Information Card -->
    <PreferenceCategory
        android:key="kamisato_hardware_info_category"
        android:order="20"
        android:title="@string/kamisato_about_hardware_info"
        android:icon="@drawable/ic_kamisato_hardware">

        <!-- SoC (ro.kamisato.soc) -->
        <Preference
            android:key="kamisato_soc"
            android:order="21"
            android:title="@string/kamisato_soc"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.kamisato.KamisatoSocPreferenceController"
            settings:enableCopying="true"/>

        <!-- RAM (dynamic) -->
        <Preference
            android:key="kamisato_ram"
            android:order="22"
            android:title="@string/kamisato_ram"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.kamisato.KamisatoRamPreferenceController"
            settings:enableCopying="true"/>

        <!-- Storage (dynamic) -->
        <Preference
            android:key="kamisato_storage"
            android:order="23"
            android:title="@string/kamisato_storage"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.kamisato.KamisatoStoragePreferenceController"
            settings:enableCopying="true"/>

        <!-- Display (ro.kamisato.display) -->
        <Preference
            android:key="kamisato_display"
            android:order="24"
            android:title="@string/kamisato_display"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.kamisato.KamisatoDisplayPreferenceController"
            settings:enableCopying="true"/>

    </PreferenceCategory>

    <!-- Camera Information Card -->
    <PreferenceCategory
        android:key="kamisato_camera_info_category"
        android:order="30"
        android:title="@string/kamisato_about_camera_info"
        android:icon="@drawable/ic_kamisato_camera">

        <!-- Front Camera (ro.kamisato.frontcam) -->
        <Preference
            android:key="kamisato_front_camera"
            android:order="31"
            android:title="@string/kamisato_front_camera"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.kamisato.KamisatoFrontCameraPreferenceController"
            settings:enableCopying="true"/>

        <!-- Rear Camera (ro.kamisato.backcam) -->
        <Preference
            android:key="kamisato_rear_camera"
            android:order="32"
            android:title="@string/kamisato_rear_camera"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.kamisato.KamisatoRearCameraPreferenceController"
            settings:enableCopying="true"/>

    </PreferenceCategory>

    <!-- ROM Information Card -->
    <PreferenceCategory
        android:key="kamisato_rom_info_category"
        android:order="40"
        android:title="@string/kamisato_about_rom_info"
        android:icon="@drawable/ic_kamisato_rom">

        <!-- ROM Name -->
        <Preference
            android:key="kamisato_rom_name"
            android:order="41"
            android:title="@string/kamisato_rom_version"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.kamisato.KamisatoRomNamePreferenceController"
            settings:enableCopying="true"/>

        <!-- Android version -->
        <Preference
            android:key="firmware_version"
            android:order="42"
            android:title="@string/kamisato_android_version"
            android:summary="@string/summary_placeholder"
            android:fragment="com.android.settings.deviceinfo.firmwareversion.FirmwareVersionSettings"
            settings:controller="com.android.settings.deviceinfo.firmwareversion.FirmwareVersionPreferenceController"/>

        <!-- Security Patch -->
        <Preference
            android:key="security_key"
            android:order="43"
            android:title="@string/kamisato_security_patch"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.firmwareversion.SecurityPatchLevelPreferenceController"
            settings:enableCopying="true"/>

        <!-- Build Date -->
        <Preference
            android:key="kamisato_build_date"
            android:order="44"
            android:title="@string/kamisato_build_date"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.kamisato.KamisatoBuildDatePreferenceController"
            settings:enableCopying="true"/>

        <!-- Kernel Version -->
        <Preference
            android:key="kernel_version"
            android:order="45"
            android:title="@string/kamisato_kernel_version"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:controller="com.android.settings.deviceinfo.KernelVersionPreferenceController"
            settings:enableCopying="true"/>

        <!-- Build number (for developer options) -->
        <Preference
            android:key="build_number"
            android:order="46"
            android:title="@string/build_number"
            android:summary="@string/summary_placeholder"
            settings:enableCopying="true"
            settings:controller="com.android.settings.deviceinfo.BuildNumberPreferenceController"/>

    </PreferenceCategory>

    <!-- Device Identifiers -->
    <PreferenceCategory
        android:key="device_identifiers_category"
        android:order="50"
        android:title="@string/my_device_info_device_identifiers_category_title">

        <!-- SIM status -->
        <Preference
            android:key="sim_status"
            android:order="51"
            android:title="@string/sim_status_title"
            settings:keywords="@string/keywords_sim_status"
            android:summary="@string/summary_placeholder"
            settings:isPreferenceVisible="@bool/config_show_sim_info"
            settings:controller="com.android.settings.deviceinfo.simstatus.SimStatusPreferenceController"/>

        <!-- EID -->
        <com.android.settings.deviceinfo.simstatus.SimEidInfoPreference
            android:key="eid_info"
            android:order="52"
            android:title="@string/status_eid"
            android:positiveButtonText="@string/dlg_ok"
            android:dialogLayout="@layout/dialog_eid_status"
            settings:isPreferenceVisible="@bool/config_show_sim_info"
            settings:enableCopying="true"
            settings:controller="com.android.settings.deviceinfo.simstatus.SimEidPreferenceController"/>

        <!-- IMEI -->
        <Preference
            android:key="imei_info"
            android:order="53"
            android:title="@string/status_imei"
            android:summary="@string/summary_placeholder"
            settings:keywords="@string/keywords_imei_info"
            settings:enableCopying="true"
            settings:isPreferenceVisible="@bool/config_show_sim_info"
            settings:controller="com.android.settings.deviceinfo.imei.ImeiInfoPreferenceController"/>

        <!-- Model & hardware -->
        <Preference
            android:key="device_model"
            android:order="54"
            android:title="@string/model_info"
            android:summary="@string/summary_placeholder"
            android:fragment="com.android.settings.deviceinfo.hardwareinfo.HardwareInfoFragment"
            settings:enableCopying="true"
            settings:keywords="@string/keywords_model_and_hardware"
            settings:controller="com.android.settings.deviceinfo.HardwareInfoPreferenceController"/>

        <!-- IP address -->
        <Preference
            android:key="wifi_ip_address"
            android:order="55"
            android:title="@string/wifi_ip_address"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:enableCopying="true"/>

        <!-- Wi-Fi MAC address -->
        <Preference
            android:key="saved_accesspoints_wifi_mac_address"
            android:order="56"
            android:title="@string/status_wifi_mac_address"
            android:summary="@string/view_saved_network"
            android:fragment="com.android.settings.wifi.savedaccesspoints2.SavedAccessPointsWifiSettings2"
            settings:enableCopying="false"/>

        <!-- Factory Wi-Fi MAC address -->
        <Preference
            android:key="wifi_mac_address"
            android:order="57"
            android:title="@string/status_device_wifi_mac_address"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:enableCopying="true"/>

        <!-- Bluetooth address -->
        <Preference
            android:key="bt_address"
            android:order="58"
            android:title="@string/status_bt_address"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:enableCopying="true"/>

        <!-- Device up time -->
        <Preference
            android:key="up_time"
            android:order="59"
            android:title="@string/status_up_time"
            android:summary="@string/summary_placeholder"
            android:selectable="false"/>

    </PreferenceCategory>

    <!-- Legal & Regulatory -->
    <PreferenceCategory
        android:key="legal_category"
        android:order="60"
        android:title="@string/my_device_info_legal_category_title">

        <!-- Legal information -->
        <Preference
            android:key="legal_container"
            android:order="61"
            android:title="@string/legal_information"
            android:fragment="com.android.settings.LegalSettings"/>

        <!-- Regulatory labels -->
        <Preference
            android:key="regulatory_info"
            android:order="62"
            android:title="@string/regulatory_labels">
            <intent android:action="android.settings.SHOW_REGULATORY_INFO"
                    android:targetPackage="${applicationId}"/>
        </Preference>

        <!-- Safety & regulatory manual -->
        <Preference
            android:key="safety_info"
            android:order="63"
            android:title="@string/safety_and_regulatory_info"/>

        <!-- Manual -->
        <Preference
            android:key="manual"
            android:order="64"
            android:title="@string/manual">
            <intent android:action="android.settings.SHOW_MANUAL"
                    android:targetPackage="${applicationId}"/>
        </Preference>

        <!-- Feedback on the device -->
        <Preference
            android:key="device_feedback"
            android:order="65"
            android:title="@string/device_feedback"
            settings:keywords="@string/keywords_device_feedback"/>

        <!-- Device FCC equipment id -->
        <Preference
            android:key="fcc_equipment_id"
            android:order="66"
            android:title="@string/fcc_equipment_id"
            android:summary="@string/summary_placeholder"/>

        <!-- Radio Info -->
        <Preference
            android:title="@string/radio_info_title"
            android:key="radio_info_settings"
            android:order="67">
            <intent android:action="android.intent.action.MAIN"
                    android:targetPackage="com.android.phone"
                    android:targetClass="com.android.phone.settings.RadioInfo" />
         </Preference>

    </PreferenceCategory>

</PreferenceScreen>

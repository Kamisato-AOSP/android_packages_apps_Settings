<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:androidprv="http://schemas.android.com/apk/prv/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="12dp">

    <!-- Storage Card - True Pill Shape -->
    <LinearLayout
        android:id="@+id/kamisato_storage_card_container"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/kamisato_pill_card_background"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <!-- Storage Icon -->
        <ImageView
            android:id="@+id/kamisato_storage_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_storage"
            android:tint="@androidprv:color/materialColorOnSurface"
            android:contentDescription="@string/kamisato_storage_card_title" />

        <!-- Content Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp">

            <!-- Storage Title -->
            <TextView
                android:id="@+id/kamisato_storage_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kamisato_storage_card_title"
                android:textSize="11sp"
                android:textColor="@androidprv:color/materialColorOnSurface"
                android:alpha="0.7"
                android:maxLines="1"
                android:ellipsize="none" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/kamisato_storage_progress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:progressDrawable="@drawable/kamisato_storage_progress"
                android:max="100"
                android:progress="0"
                tools:progress="75" />

        </LinearLayout>

        <!-- Storage Usage -->
        <TextView
            android:id="@+id/kamisato_storage_usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@androidprv:color/materialColorOnSurface"
            android:textStyle="bold"
            android:maxLines="1"
            tools:text="20.7/256GB" />

    </LinearLayout>

    <!-- RAM Card - True Pill Shape -->
    <LinearLayout
        android:id="@+id/kamisato_ram_card_container"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/kamisato_pill_card_background"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <!-- RAM Icon -->
        <ImageView
            android:id="@+id/kamisato_ram_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_memory"
            android:tint="@androidprv:color/materialColorOnSurface"
            android:contentDescription="@string/kamisato_ram_card_title" />

        <!-- Content Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp">

            <!-- RAM Title -->
            <TextView
                android:id="@+id/kamisato_ram_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kamisato_ram_card_title"
                android:textSize="11sp"
                android:textColor="@androidprv:color/materialColorOnSurface"
                android:alpha="0.7"
                android:maxLines="1"
                android:ellipsize="none" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/kamisato_ram_progress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:progressDrawable="@drawable/kamisato_ram_progress"
                android:max="100"
                android:progress="0"
                tools:progress="50" />

        </LinearLayout>

        <!-- RAM Usage -->
        <TextView
            android:id="@+id/kamisato_ram_usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@androidprv:color/materialColorOnSurface"
            android:textStyle="bold"
            android:maxLines="1"
            tools:text="4.2/8GB" />

    </LinearLayout>

</LinearLayout>
